<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary" app:titleTextColor="@color/white" app:title="@string/title_settings" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- 定位注入仿真 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:layout_marginBottom="0dp" app:cardElevation="2dp" app:cardCornerRadius="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="定位注入仿真" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/whale_primary_dark" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/pref_accuracy" android:textStyle="bold" />
                    <SeekBar android:id="@+id/accBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" />
                    <TextView android:id="@+id/accVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 m" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#EEEEEE" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="注入海拔（米）" android:textStyle="bold" />
                    <SeekBar android:id="@+id/altBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500" />
                    <TextView android:id="@+id/altVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="55 m" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#EEEEEE" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="随机偏移（防检测微抖动）" android:textStyle="bold" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/randomOffsetSwitch"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="偏移半径（米）" android:textStyle="bold" />
                    <SeekBar android:id="@+id/offsetBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" />
                    <TextView android:id="@+id/offsetVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 m" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 摇杆速度（三档） -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:layout_marginBottom="0dp" app:cardElevation="2dp" app:cardCornerRadius="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="摇杆速度（走 / 跑 / 骑 三档）" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/whale_primary_dark" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="步行（米/秒）" android:textStyle="bold" />
                    <SeekBar android:id="@+id/walkBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" />
                    <TextView android:id="@+id/walkVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.2 m/s" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="跑步（米/秒）" android:textStyle="bold" />
                    <SeekBar android:id="@+id/runBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
                    <TextView android:id="@+id/runVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3.6 m/s" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="骑行（米/秒）" android:textStyle="bold" />
                    <SeekBar android:id="@+id/bikeBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" />
                    <TextView android:id="@+id/bikeVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10.0 m/s" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 历史记录 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:layout_marginBottom="0dp" app:cardElevation="2dp" app:cardCornerRadius="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="历史记录有效期（天）" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/whale_primary_dark" />
                    <SeekBar android:id="@+id/historyDaysBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" />
                    <TextView android:id="@+id/historyDaysVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 天" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 关于 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp" android:layout_marginBottom="12dp" app:cardElevation="2dp" app:cardCornerRadius="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/rowCheckUpdate" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp" android:text="@string/pref_check_update" android:textSize="16sp"
                        android:textColor="@color/whale_primary_dark" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />
                    <TextView android:id="@+id/rowDisclaimer" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp" android:text="@string/pref_disclaimer" android:textSize="16sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />
                    <TextView android:id="@+id/rowAbout" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp" android:text="@string/pref_about" android:textSize="16sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />
                    <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp" android:textSize="13sp" android:textColor="#888888" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
